# ============================================================================
# SalesMoy — Sales Doctor ↔ MoySklad Integration
# Root .env.example  (production, single-server / Dokploy deployment)
# ----------------------------------------------------------------------------
# Copy to `.env` on the server and fill in the real values.
# `.env` is git-ignored — it MUST NOT be committed.
#
# NOTE ON ARCHITECTURE:
# Per-tenant secrets (MoySklad token, Sales Doctor login/password/token,
# webhook secrets) are NOT set here. They are entered per company through the
# app's Settings UI and stored ENCRYPTED in PostgreSQL. The values below are
# the *server-wide* configuration only.
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION  (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────

# Master secret. Used for BOTH:
#   1. Signing JWT session tokens.
#   2. Deriving the Fernet key that ENCRYPTS Sales Doctor passwords in the DB.
# ⚠️  CRITICAL: if this value changes, every stored SD password becomes
#     undecryptable and all users must re-enter credentials. Keep it STABLE.
#     Must be a strong random string, min 32 chars.
#     Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-this-to-a-secure-random-string-min-32-chars

# false in production. Enables SQL echo + verbose logging + auto-reload when true.
DEBUG=false

# false in production. When true the app short-circuits real MS/SD calls.
TEST_MODE=false

# Comma-separated list of allowed browser origins (your frontend URL).
# No trailing slash. Example: https://app.pipely.uz
CORS_ORIGINS=https://your-domain.com

# JWT session lifetime in minutes. Default 10080 = 7 days. Optional.
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE  (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────

# Production PostgreSQL (async driver). In docker-compose this is assembled
# from DB_PASSWORD; if you run the backend directly, set the full URL here.
DATABASE_URL=postgresql+asyncpg://integration_user:CHANGE_ME@db:5432/integration

# Password for the bundled postgres container. Used by docker-compose to build
# both the DB and the DATABASE_URL above. Pick a strong value.
DB_PASSWORD=change-this-strong-db-password

# Local dev alternative (SQLite, no server needed):
# DATABASE_URL=sqlite+aiosqlite:///./integration.db

# ─────────────────────────────────────────────────────────────────────────────
# REDIS  (OPTIONAL — provisioned but currently UNUSED by the code)
# ─────────────────────────────────────────────────────────────────────────────
# No module imports Redis today. Safe to leave as default or drop the service.
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# PUBLIC URL / WEBHOOKS  (REQUIRED for MoySklad webhook auto-registration)
# ─────────────────────────────────────────────────────────────────────────────

# Public HTTPS base URL of this server. MUST start with https://.
# MoySklad webhooks are registered against {PUBLIC_BASE_URL}/webhook/moysklad.
PUBLIC_BASE_URL=https://your-domain.com

# Optional server-wide webhook secret / URL (per-tenant secrets live in DB).
# WEBHOOK_SECRET=
# WEBHOOK_URL=https://your-domain.com/webhook

# ─────────────────────────────────────────────────────────────────────────────
# MOYSKLAD  (OPTIONAL global fallback — real token is per-tenant in the DB/UI)
# ─────────────────────────────────────────────────────────────────────────────
MOYSKLAD_BASE_URL=https://api.moysklad.ru/api/remap/1.2
# MOYSKLAD_TOKEN=            # dev/test fallback only
# MOYSKLAD_ACCOUNT=

# MoySklad returns order `moment` in the account's local timezone (Moscow/UTC+3
# by default). Hours to subtract to store true UTC. Set 0 if the account is UTC.
MOYSKLAD_ACCOUNT_UTC_OFFSET_HOURS=3

# How many days back the incremental order sync scans (webhook safety net).
INITIAL_ORDER_LOOKBACK_DAYS=3

# ─────────────────────────────────────────────────────────────────────────────
# SALES DOCTOR  (per-tenant login/password/token live in the DB/UI)
# ─────────────────────────────────────────────────────────────────────────────
# Global default base URL; each tenant may override in Settings.
SALESDOCTOR_BASE_URL=https://api.salesdoctor.uz/v2

# Sales Doctor's TLS cert often has a hostname mismatch. Options:
#   false (default) — skip verification (logs a warning)
#   true            — enforce verification
#   /path/to/ca.pem — verify against a custom CA bundle
SD_VERIFY_SSL=false

# Hours added to the stored UTC order time before sending to SD as order date.
SALESDOCTOR_ORDER_DATE_OFFSET_HOURS=5

# ─────────────────────────────────────────────────────────────────────────────
# SYNC INTERVALS (seconds) / CURRENCY  (OPTIONAL — sensible defaults exist)
# ─────────────────────────────────────────────────────────────────────────────
STOCK_SYNC_INTERVAL=60
DEBT_SYNC_INTERVAL=600
CLIENT_SYNC_INTERVAL=300
ORDER_SYNC_INTERVAL=60

# Consider a tenant's sync "stale" after this many minutes of no success.
SYNC_STALE_AFTER_MINUTES=10

# Fallback currency assumed for MoySklad prices when none is expanded.
FORCE_PRICE_CURRENCY=USD

# Fallback USD→UZS rate (used only when the order carries no explicit rate).
USD_TO_UZS_RATE=12695

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (build-time, Vite) — OPTIONAL
# ─────────────────────────────────────────────────────────────────────────────
# API base URL baked into the built frontend. Empty = same-origin (recommended
# when nginx serves both frontend and /api on one domain).
# VITE_API_URL=
